+// Opt-in paired gate/up TQ rows for RTX 30 (SM86).  The default path remains unchanged.
+bool tq_ampere_pair_rows_on() {
+#if defined(__HIPCC__)
+    return false;
+#else
+    static const bool requested = [] {
+        const char* v = std::getenv("STRATA_TQ_AMPERE_ROWS");
+        return v != nullptr && std::strcmp(v, "2") == 0;
+    }();
+    if (!requested) return false;
+    int dev = 0, major = 0, minor = 0;
+    if (cudaGetDevice(&dev) != cudaSuccess ||
+        cudaDeviceGetAttribute(&major, cudaDevAttrComputeCapabilityMajor, dev) != cudaSuccess ||
+        cudaDeviceGetAttribute(&minor, cudaDevAttrComputeCapabilityMinor, dev) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return false;
+    }
+    return major == 8 && minor == 6;
+#endif
+}
+
 // row chunks per block of the staged trellis gate/up and down kernels (STRATA_TQ_ROWCH, default 4)
 int tq_row_chunks() {
     static const int n = [] {
@@ -4248,6 +4368,15 @@ void launch_gu(dim3 grid, cudaStream_t s, const unsigned long long* grp_ptr, con
             if (tq_sub8_on() && (L.n_embd / Fmt<TG>::qk) * Fmt<TG>::ipb == 160) {
                 dim3 g8 = grid;
                 g8.x = (unsigned) ((2 * L.n_ff + 31) / 32);
+#if !defined(__HIPCC__)
+                if (tq_ampere_pair_rows_on()) {
+                    dim3 pair_grid = grid;
+                    pair_grid.x = (unsigned) ((L.n_ff + 31) / 32);
+                    tq_ampere_pair_gu_kernel<TG><<<pair_grid, 256, 0, s>>>(
+                        grp_ptr, grp_start, n_groups, ent_tok, X, L, gate, up);
+                    return;
+                }
+#endif
                 native_gu_multi_kernel<TG, true, true><<<g8, 256, 0, s>>>(grp_ptr, grp_start, n_groups, ent_tok, X, L, gate, up);
                 return;
             }
