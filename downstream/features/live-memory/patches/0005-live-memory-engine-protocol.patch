+// ---------------- PR4 Phase 3: the Engine's MEMORY handling, pure parts ----------------
+
+// A terminal ACK state.  Every MEMORY request ends in exactly one: OK (the target was reached), PARTIAL
+// (a limit or the floor stopped the step; the ACTUAL capacity is reported) or REFUSED (nothing applied).
+// There is no asynchronous state: the sender does not poll, the engine answers once.
+enum class LiveMemoryAck { Ok, Partial, Refused };
+
+// The ACK line, the VRAM command's key=value shape:
+//   ACK <id> <OK|PARTIAL|REFUSED> ram_resident_mib=<n> vram_committed_mib=<n> vram_reserve_mib=<n>[ note=<words>]
+// The numbers are the ACTUAL capacity after the request (not what was asked); `note` carries the reason a
+// PARTIAL or REFUSED stopped short, as words with '_' in place of spaces.
+inline std::string live_memory_ack_line(uint64_t id, LiveMemoryAck state, uint64_t ram_resident_mib,
+                                        uint64_t vram_committed_mib, uint64_t vram_reserve_mib,
+                                        const std::string& note) {
+    const char* name = state == LiveMemoryAck::Ok ? "OK" : state == LiveMemoryAck::Partial ? "PARTIAL" : "REFUSED";
+    std::ostringstream out;
+    out << "ACK " << id << ' ' << name << " ram_resident_mib=" << ram_resident_mib
+        << " vram_committed_mib=" << vram_committed_mib << " vram_reserve_mib=" << vram_reserve_mib;
+    if (!note.empty()) out << " note=" << note;
+    return out.str();
+}
+
+// The CAPACITY report: actual RAM resident in the Live Memory tiers, a FRESH cgroup-aware available-RAM
+// reading, the expert cache's committed bytes, the free VRAM and the reserve.  Emitted after every MEMORY
+// ACK and VRAM command, on a `CAPACITY` line, and periodically between requests while Live Memory is on.
+inline std::string live_memory_capacity_line(uint64_t ram_resident_mib, uint64_t ram_available_mib,
+                                             uint64_t vram_committed_mib, uint64_t vram_free_mib,
+                                             uint64_t vram_reserve_mib) {
+    std::ostringstream out;
+    out << "CAPACITY ram_resident_mib=" << ram_resident_mib << " ram_available_mib=" << ram_available_mib
+        << " vram_committed_mib=" << vram_committed_mib << " vram_free_mib=" << vram_free_mib
+        << " vram_reserve_mib=" << vram_reserve_mib;
+    return out.str();
+}
+
+// The one pending request slot.  A MEMORY line that arrives while the engine cannot apply changes (a
+// prompt's loan is out, batch slots are decoding) waits here and is applied at the next between-requests
+// boundary - instead of being refused, which would make every resize race the conversation it serves.  A
+// NEWER request replaces the pending one only when it releases capacity in both tiers
+// (live_memory_supersedes); anything else is refused at once, so the sender learns now rather than after
+// the old request's effects landed.
+struct LiveMemoryPending {
+    // True: the request is now pending (or replaced the pending one).  False: refused now; `why` says why.
+    bool push(const LiveMemoryRequest& next, uint64_t resident_bytes, std::string& why) {
+        if (request.id == 0) {
+            request = next;
+            why.clear();
+            return true;
+        }
+        if (live_memory_supersedes(next, request, resident_bytes)) {
+            request = next;
+            why.clear();
+            return true;
+        }
+        why = "a capacity change is already waiting (id " + std::to_string(request.id) + "); supersede it by "
+              "releasing capacity in both tiers, or wait for its ACK";
+        return false;
+    }
+    // The pending request, or false when none waits (id 0 after: it has been taken).
+    bool take(LiveMemoryRequest& out) {
+        if (request.id == 0) return false;
+        out = request;
+        request = LiveMemoryRequest{};
+        return true;
+    }
+    bool active() const { return request.id != 0; }
+    LiveMemoryRequest request;
+};
+
 } // namespace strata::core
