+bool ExpertCache::resize_transactional(int64_t want_bytes, std::string& err) {
+    err.clear();
+    if (segs_.empty()) {
+        err = "the expert cache is not segmented (Live Memory needs CUDA VMM)";
+        return false;
+    }
+    if (want_bytes < 0) {
+        err = "the requested expert-cache capacity must not be negative";
+        return false;
+    }
+
+    const int64_t before = mapped_bytes();
+    if (want_bytes == before) return true;
+
+    // shrink() rounds up to whole segments. Check the exact prefix it will retain, not the
+    // caller's unrounded byte request, so no resident expert can be left in an unmapped slot.
+    if (want_bytes < before) {
+        int64_t rounded_keep = 0;
+        for (size_t i = 0; i < seg_size_.size() && rounded_keep < want_bytes; ++i)
+            rounded_keep += seg_size_[i];
+        const int64_t keep_slots = slots_within(rounded_keep);
+        for (size_t i = 0; i < residency_.size(); ++i) {
+            if (residency_[i] >= keep_slots) {
+                err = "cannot shrink the expert cache: a resident expert still occupies a slot beyond the target";
+                return false;
+            }
+        }
+    }
+
+    if (cudaDeviceSynchronize() != cudaSuccess) {
+        err = std::string("the device failed before the expert cache resized: ") +
+              cudaGetErrorString(cudaGetLastError());
+        return false;
+    }
+
+    std::string operation_error;
+    const bool ok = want_bytes < before ? shrink(want_bytes, operation_error)
+                                        : grow(want_bytes, operation_error);
+    if (ok) return true;
+
+    // grow()/shrink() intentionally expose partial progress for the legacy --vram-elastic
+    // caller. Live Memory instead tries to restore the pre-request prefix before returning.
+    const int64_t partial = mapped_bytes();
+    std::string rollback_error;
+    if (partial < before) (void) grow(before, rollback_error);
+    else if (partial > before) (void) shrink(before, rollback_error);
+
+    const int64_t actual = mapped_bytes();
+    live_slots_ = slots_within(actual);
+    if (actual == before) {
+        err = operation_error.empty() ? "expert-cache resize failed; original capacity restored"
+                                      : operation_error + "; original mapped capacity restored";
+    } else {
+        err = (operation_error.empty() ? "expert-cache resize failed" : operation_error) +
+              "; rollback incomplete: actual mapped capacity is " + std::to_string(actual) +
+              " of " + std::to_string(before) + " bytes";
+        if (!rollback_error.empty()) err += " (" + rollback_error + ")";
+    }
+    return false;
+}
