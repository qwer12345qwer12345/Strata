+// ---- Live Memory (PR4 Phase 2): the independently releasable RAM blocks tier ----
+
+// The pinned step's trampolines (declared in the header; it has no cuda_runtime.h).  A refused cudaHostAlloc
+// returns null and the PinnedFallbackAllocator takes the pageable block instead - the tier works either way.
+void* FileExpertSource::live_ram_pin_alloc(size_t bytes) {
+    void* p = nullptr;
+    if (cudaHostAlloc(&p, bytes, cudaHostAllocDefault) != cudaSuccess || p == nullptr) {
+        (void) cudaGetLastError();
+        return nullptr;
+    }
+    return p;
