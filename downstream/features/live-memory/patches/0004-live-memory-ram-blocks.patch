diff --git a/engine/include/strata/core/ram_expert_blocks.hpp b/engine/include/strata/core/ram_expert_blocks.hpp
new file mode 100644
index 000000000..538ba93e4
--- /dev/null
+++ b/engine/include/strata/core/ram_expert_blocks.hpp
@@ -0,0 +1,289 @@
+// include/strata/core/ram_expert_blocks.hpp - Live Memory: independently releasable RAM expert blocks.
+//
+// The startup complement (`pin_cache_complement`) is ONE allocation sized once at start. Live Memory instead
+// takes RAM in BLOCKS: bounded allocations, each holding a plan's worth of expert blobs, that a later
+// `MEMORY <id> <resident-mib> <vram-reserve-mib>` request can give back WHOLE - a shrink releases the
+// last-grown blocks first, and a released expert falls back to the mapped files exactly like one a budget
+// left out (its bytes are re-read from the file when routed again).
+//
+// Two rules carry the safety, and both are enforced HERE rather than trusted to the caller:
+//
+//   1. **A block's entries are unpublished BEFORE its memory is freed.**  The flat-index table is erased
+//      under the store's lock for every entry of the dying block, so from that moment no `blob()` /
+//      `resident_blob()` lookup can reach into it - then, and only then, the allocator gets the pointer
+//      back.  (The Engine's safe-point contract still applies: release is called between requests, with
+//      every window drained and every loan back - this class cannot see an in-flight window, and a raw
+//      pointer handed out before the release stays in the reader's hand until the layer is over.)
+//   2. **A failed grow leaves nothing behind.**  The block is allocated, filled by the caller's `filler`,
+//      and only published (index + counters) once the filler returned true.  A refused allocation, a filler
+//      failure or an exception rolls the whole step back: the store looks exactly as it did before.
+//
+// GROWTH IS ADMISSION-GUARDED OUTSIDE: the caller samples the host memory (cgroup-aware) and refuses the
+// step before calling `grow`.  The store takes no readings of its own - the tests inject the allocator and
+// the filler, and the production caller keeps the policy in one place (FileExpertSource::live_ram_grow).
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <limits>
+#include <mutex>
+#include <new>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace strata::core {
+
+// ---------------- pure policy helpers (CPU-testable, live_memory.hpp's style) ----------------
+
+// One growth step's block size: what the request asked for, capped at `max_block_bytes` so a later release
+// can free RAM in bounded whole-block steps (and one bad allocation cannot take it all at once).  0
+// requested stays 0; `max_block_bytes` 0 means unbounded (the caller did not cap it).
+inline uint64_t live_ram_block_bytes(uint64_t requested, uint64_t max_block_bytes) {
+    if (max_block_bytes != 0 && max_block_bytes < requested) return max_block_bytes;
+    return requested;
+}
+
+// Which experts one growth step admits: the pairs of `rank` (hottest first) that no tier holds yet, while
+// their blobs fit `budget` bytes.  `held(flat_index)` answers for every tier the caller knows (the GPU
+// cache's residency, the startup complement, the blocks already taken); a held pair is skipped, and a pair
+// whose blob does not fit the REST of the budget does not end the walk - a later, smaller blob of a colder
+// layer may still fit (a native pack's layer blob sizes differ).  `out` receives the pairs in rank order;
+// the total bytes are returned (0: nothing fits or nothing was offered - "nothing left to admit", not an
+// error).
+template<class Held, class BlobBytes>
+uint64_t live_ram_fill_plan(const std::vector<std::pair<int32_t, int32_t>>& rank, uint64_t budget,
+                            Held held, BlobBytes blob_bytes, std::vector<std::pair<int32_t, int32_t>>& out) {
+    out.clear();
+    uint64_t bytes = 0;
+    for (const auto& [layer, expert] : rank) {
+        if (layer < 0 || expert < 0) continue;
+        if (held((size_t) layer, (size_t) expert)) continue;
+        const uint64_t b = blob_bytes(layer, expert);
+        if (b == 0 || b > budget - bytes) continue;
+        bytes += b;
+        out.emplace_back(layer, expert);
+    }
+    return bytes;
+}
+
+// ---------------- the store ----------------
+
+class RamExpertBlocks {
+public:
+    // The allocation is behind an interface so the tests can inject failures (PORT_PLAN's allocation and
+    // rollback gates) and so the pinned path stays out of this header (no cuda_runtime.h here).
+    struct Allocator {
+        virtual void* alloc(size_t bytes, bool& pinned) = 0;
+        virtual void free(void* p, bool pinned) noexcept = 0;
+        virtual ~Allocator() = default;
+    };
+
+    // Plain heap memory: the DEFAULT and the fallback.  Pageable allocations cannot fail the process the
+    // way one huge page-locked one can (#1250): the kernel pages them out instead.
+    class PageableAllocator final : public Allocator {
+    public:
+        void* alloc(size_t bytes, bool& pinned) override {
+            pinned = false;
+            return std::malloc(bytes);
+        }
+        void free(void* p, bool /*pinned*/) noexcept override { std::free(p); }
+    };
+
+    // Forwards to a target that can be swapped before the first grow (the production caller turns pageable
+    // into pinned-with-fallback in set_live_ram; null forwards nowhere and grow refuses).
+    class DispatchAllocator final : public Allocator {
+    public:
+        explicit DispatchAllocator(Allocator* t = nullptr) : target(t) {}
+        void* alloc(size_t bytes, bool& pinned) override { return target != nullptr ? target->alloc(bytes, pinned) : nullptr; }
+        void free(void* p, bool pinned) noexcept override {
+            if (target != nullptr) target->free(p, pinned);
+        }
+        Allocator* target;
+    };
+
+    // Live Memory's optional pinned step: the caller wires `pin_alloc` / `pin_free` (cudaHostAlloc /
+    // cudaFreeHost trampolines, wired in the .cpp - no cuda_runtime.h here) at construction; a refused pin
+    // FALLS BACK to the inner allocator's pageable block rather than failing the growth - the tier works
+    // either way, only slower to DMA from.  `pin_enabled` (optional) gates the pinned attempt at alloc time,
+    // so one object serves a caller that turns pinning on and off (no reassignment: the reference member).
+    class PinnedFallbackAllocator final : public Allocator {
+    public:
+        using AllocFn = void* (*)(size_t);
+        using FreeFn = void (*)(void*) noexcept;
+        PinnedFallbackAllocator(Allocator& inner, AllocFn pin_alloc, FreeFn pin_free, const bool* pin_enabled = nullptr)
+            : inner_(inner), pin_alloc_(pin_alloc), pin_free_(pin_free), pin_enabled_(pin_enabled) {}
+        void* alloc(size_t bytes, bool& pinned) override {
+            if (pin_alloc_ != nullptr && (pin_enabled_ == nullptr || *pin_enabled_))
+                if (void* p = pin_alloc_(bytes)) { pinned = true; return p; }
+            return inner_.alloc(bytes, pinned);
+        }
+        void free(void* p, bool pinned) noexcept override {
+            if (pinned && pin_free_ != nullptr) pin_free_(p);
+            else inner_.free(p, pinned);
+        }
+    private:
+        Allocator& inner_;
+        AllocFn pin_alloc_ = nullptr;
+        FreeFn pin_free_ = nullptr;
+        const bool* pin_enabled_ = nullptr;
+    };
+
+    struct Stats {
+        uint64_t bytes = 0;          // resident in the blocks now
+        uint64_t pinned_bytes = 0;   // of those, page-locked
+        size_t blocks = 0;
+        size_t entries = 0;
+    };
+
+    // `allocator` must outlive the store (the production caller owns both); `max_block_bytes` caps every
+    // growth step (0: unbounded - not recommended, see live_ram_block_bytes).
+    explicit RamExpertBlocks(Allocator& allocator, uint64_t max_block_bytes = 0)
+        : alloc_(allocator), max_block_bytes_(max_block_bytes) {}
+
+    RamExpertBlocks(const RamExpertBlocks&) = delete;
+    RamExpertBlocks& operator=(const RamExpertBlocks&) = delete;
+
+    // The per-blob sizes grow's layout walk uses (a native pack's blobs differ per layer); set once by the
+    // owner before the first grow.  A later grow of a layer past the list reads 0 bytes and the plan skips it.
+    void set_blob_sizes(const uint64_t* per_layer, size_t n) {
+        std::lock_guard<std::mutex> lk(mu_);
+        blob_bytes_.assign(per_layer, per_layer + n);
+    }
+
+    Stats stats() const {
+        std::lock_guard<std::mutex> lk(mu_);
+        Stats s;
+        s.blocks = blocks_.size();
+        s.entries = where_.size();
+        for (const Block& b : blocks_) {
+            s.bytes += b.bytes;
+            if (b.pinned) s.pinned_bytes += b.bytes;
+        }
+        return s;
+    }
+
+    bool holds(size_t index) const {
+        std::lock_guard<std::mutex> lk(mu_);
+        return where_.find(index) != where_.end();
+    }
+
+    // The blob's bytes in the blocks, or null.  Any thread: the index only changes at a safe point
+    // (grow / release, both under mu_), and a reader that already holds a pointer is the caller's contract.
+    const uint8_t* blob(size_t index) const {
+        std::lock_guard<std::mutex> lk(mu_);
+        const auto it = where_.find(index);
+        if (it == where_.end()) return nullptr;
+        return static_cast<const uint8_t*>(blocks_[it->second.first].p) + it->second.second;
+    }
+
+    // ONE growth step: at most `min(want_bytes, max_block_bytes)` bytes of the plan `plan(entries)` admits,
+    // copied by `filler(base, entries, bytes)`.  The entries are published only after the filler returned
+    // true; every failure path frees the block first.  `added`: bytes published; `pinned`: whether the
+    // block's memory came back page-locked (reported, never assumed).
+    template<class Plan, class Filler, class ToIndex>
+    bool grow(uint64_t want_bytes, Plan plan, Filler filler, ToIndex to_index, uint64_t& added, bool& pinned,
+              std::string& err) {
+        added = 0;
+        pinned = false;
+        err.clear();
+        const uint64_t bytes = live_ram_block_bytes(want_bytes, max_block_bytes_);
+        if (bytes == 0) { err = "the RAM step is empty"; return false; }
+        if (bytes > std::numeric_limits<size_t>::max()) { err = "the RAM step is larger than one allocation"; return false; }
+
+        void* p = nullptr;
+        bool was_pinned = false;
+        try {
+            p = alloc_.alloc((size_t) bytes, was_pinned);
+        } catch (const std::bad_alloc&) {
+            p = nullptr;
+        }
+        if (p == nullptr) {
+            err = "the host refused a " + std::to_string(bytes >> 20) + " MiB RAM block";
+            return false;
+        }
+
+        std::vector<std::pair<int32_t, int32_t>> entries;
+        const uint64_t planned = plan(entries);
+        bool ok = false;
+        if (planned > bytes) {
+            err = "the plan exceeds the RAM step's block";
+        } else if (planned == 0) {
+            err = "no expert fits the RAM step";
+        } else {
+            ok = filler(static_cast<uint8_t*>(p), entries, planned);
+            if (!ok) err = "copying the experts into the RAM block failed";
+        }
+        if (!ok) {
+            alloc_.free(p, was_pinned);   // rollback: an unpublished block is memory nobody can reach
+            return false;
+        }
+
+        std::lock_guard<std::mutex> lk(mu_);
+        Block b;
+        b.p = p;
+        b.pinned = was_pinned;
+        b.bytes = planned;
+        uint64_t at = 0;
+        for (const auto& [layer, expert] : entries) {
+            b.indexed.emplace_back(to_index(layer, expert), at);
+            at += blob_size_(layer, expert);   // the filler laid the blobs back to back in plan order
+        }
+        const size_t bi = blocks_.size();
+        for (const auto& [slot, offset] : b.indexed) where_[slot] = {bi, offset};
+        blocks_.push_back(std::move(b));
+        pinned = was_pinned;
+        added = planned;
+        return true;
+    }
+
+    // Release whole blocks, the LAST grown first, until `drop_bytes` have gone or none are left.  Every
+    // entry of a dying block is unpublished (and unreachable) before the memory goes back.  `dropped`: the
+    // bytes actually freed.  Returns false only on the internal invariant below (never reachable; asserted
+    // for the tests).
+    bool release(uint64_t drop_bytes, uint64_t& dropped, std::string& err) {
+        dropped = 0;
+        err.clear();
+        std::lock_guard<std::mutex> lk(mu_);
+        while (dropped < drop_bytes && !blocks_.empty()) {
+            const Block& b = blocks_.back();
+            for (const auto& [slot, offset] : b.indexed) {
+                if (where_.erase(slot) == 0) {   // never reachable: every published entry is indexed
+                    err = "internal: a released block's entry was not indexed";
+                    return false;
+                }
+            }
+            const uint64_t bytes = b.bytes;
+            const bool pinned = b.pinned;
+            void* p = b.p;
+            blocks_.pop_back();      // the entries are out of reach FIRST (rule 1)
+            alloc_.free(p, pinned);
+            dropped += bytes;
+        }
+        return true;
+    }
+
+private:
+    uint64_t blob_size_(int64_t layer, int64_t /*expert*/) const {
+        return layer >= 0 && (size_t) layer < blob_bytes_.size() ? blob_bytes_[(size_t) layer] : 0;
+    }
+
+    struct Block {
+        void* p = nullptr;
+        bool pinned = false;
+        uint64_t bytes = 0;
+        std::vector<std::pair<size_t, uint64_t>> indexed;   // (flat index, byte offset in the block)
+    };
+
+    Allocator& alloc_;
+    uint64_t max_block_bytes_ = 0;
+    std::vector<uint64_t> blob_bytes_;                    // per layer, for grow's layout walk
+    mutable std::mutex mu_;
+    std::vector<Block> blocks_;                           // growth order: the last is released first
+    std::unordered_map<size_t, std::pair<size_t, uint64_t>> where_;   // flat index -> (block, offset)
+};
+
+}  // namespace strata::core
