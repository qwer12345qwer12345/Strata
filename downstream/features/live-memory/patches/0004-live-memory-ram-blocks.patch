+    if (on) {
+        const RamExpertBlocks::Stats s = live_blocks_.stats();
+        std::fprintf(stderr, "FileExpertSource: Live Memory RAM blocks on (max block %llu MiB, %s)\n",
+                     (unsigned long long) (max_block_bytes >> 20), live_ram_pin_ ? "pinned with a pageable fallback" : "pageable");
+        if (s.blocks > 0)
