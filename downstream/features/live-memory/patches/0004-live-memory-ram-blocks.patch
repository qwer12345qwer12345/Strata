+bool FileExpertSource::live_ram_grow(uint64_t add_bytes, uint64_t floor_bytes,
+                                     const std::vector<std::pair<int32_t, int32_t>>& rank, uint64_t& added, bool& pinned,
+                                     std::string& err) {
+    added = 0;
+    pinned = false;
+    err.clear();
+    if (!live_ram_on_ || base_ == nullptr) {
+        err = "Live Memory RAM blocks are not enabled (STRATA_LIVE_MEMORY=1)";
+        return false;
+    }
+    // The cgroup-aware admission (PORT_PLAN Phase A.4): a fresh reading every step, fail closed when the
+    // RAM cannot be read - an unreadable reading is never treated as room.
+    const std::optional<HostMemoryReading> mem = sample_host_memory();
+    if (!mem) {
+        err = "cannot read the host memory for the RAM step (fail closed)";
+        return false;
+    }
+    const uint64_t block = live_ram_block_bytes(add_bytes, live_ram_max_block_);
+    if (block == 0) {
+        err = "the RAM step is empty";
+        return false;
+    }
+    if (!conversation_memory_admit(mem->available, block, floor_bytes)) {
+        err = "the RAM step does not fit above the floor (" + std::to_string(mem->available >> 20) + " MiB available, " +
+              std::to_string(block >> 20) + " MiB asked)";
+        return false;
+    }
+    live_blocks_.set_blob_sizes(layer_blob_bytes_.data(), layer_blob_bytes_.size());
+    // The plan: the rank's pairs no tier holds (the GPU cache's are the Engine's rank's job to skip; the
+    // complement's and the blocks' are checked here), until the block's budget is full.
+    auto plan = [&](std::vector<std::pair<int32_t, int32_t>>& entries) -> uint64_t {
+        return live_ram_fill_plan(rank, block,
+                                  [&](size_t layer, size_t expert) {
+                                      const size_t index = layer * (size_t) n_expert_ + expert;
+                                      return (complement_offsets_.size() > index && complement_offsets_[index] != kNoComplement) ||
+                                             live_blocks_.holds(index);
+                                  },
+                                  [&](int64_t layer, int64_t) -> uint64_t {
+                                      return layer >= 0 && (size_t) layer < layer_blob_bytes_.size()
+                                                 ? layer_blob_bytes_[(size_t) layer] : 0;
+                                  },
+                                  entries);
+    };
+    auto filler = [&](uint8_t* base, const std::vector<std::pair<int32_t, int32_t>>& entries, uint64_t) -> bool {
+        uint64_t at = 0;
+        for (const auto& [layer, expert] : entries) {
+            if (!copy_from_files(layer, expert, base + at)) return false;
+            at += layer_blob_bytes_[(size_t) layer];
+        }
+        return true;
+    };
+    const uint64_t t0_files = file_read_bytes_.load(std::memory_order_relaxed);
+    const bool ok = live_blocks_.grow(block, plan, filler,
+                                      [&](int64_t layer, int64_t expert) -> size_t {
+                                          return (size_t) layer * (size_t) n_expert_ + (size_t) expert;
+                                      },
+                                      added, pinned, err);
+    if (ok) {
+        const RamExpertBlocks::Stats s = live_blocks_.stats();
+        std::fprintf(stderr, "FileExpertSource: Live Memory RAM + %llu MiB (%zu blocks, %zu entries, %llu MiB resident%s); "
+                             "%.0f MiB read from the files\n",
+                     (unsigned long long) (added >> 20), s.blocks, s.entries,
+                     (unsigned long long) (s.bytes >> 20), pinned ? ", pinned" : "",
+                     (double) (file_read_bytes_.load(std::memory_order_relaxed) - t0_files) / 1048576.0);
+        std::fflush(stderr);
+    }
+    return ok;
+}
+
+bool FileExpertSource::live_ram_release(uint64_t drop_bytes, uint64_t& dropped, uint64_t& remaining, std::string& err) {
+    dropped = 0;
+    remaining = 0;
+    err.clear();
+    if (!live_ram_on_) {
+        err = "Live Memory RAM blocks are not enabled (STRATA_LIVE_MEMORY=1)";
+        return false;
+    }
+    // An exchange still staged reads its blobs from buffers the commit will move; a release would race it.
+    if (!staged_.empty()) {
+        err = "an expert exchange is still staged; land it first";
+        return false;
+    }
+    if (!live_blocks_.release(drop_bytes, dropped, err)) return false;
+    remaining = live_blocks_.stats().bytes;
+    if (dropped > 0)
+        std::fprintf(stderr, "FileExpertSource: Live Memory RAM - %llu MiB (%llu MiB still resident)\n",
+                     (unsigned long long) (dropped >> 20), (unsigned long long) (remaining >> 20));
+    std::fflush(stderr);
+    return true;
+}
