+    static constexpr uint32_t kMaxStubTokens = 1u << 26;      // (a 67M-token stub is not a conversation)
+    static constexpr uint32_t kMaxStubImages = 1u << 20;
+    static constexpr uint32_t kMaxStubCheckpoints = 4096;
+
+    mutable std::mutex mu_;
+    std::filesystem::path dir_;
+    SessionFileIdentity id_{};
+    uint64_t cap_ = 0, used_ = 0, next_serial_ = 1;
+    std::vector<Entry> entries_;   // oldest serial first; the flush appends, the scan sorts
+};
