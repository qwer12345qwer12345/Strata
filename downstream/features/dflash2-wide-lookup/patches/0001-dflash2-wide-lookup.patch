+"""One explicit, sequential long-run suite; never imported by normal startup."""
+import datetime
+import hashlib
+import json
+import os
+from pathlib import Path
+import time
+from l2 import headless_experiments as comparisons
+from l2 import kernel_check
+
+DEFAULT_BUDGET_S = 72 * 3600
+
+
+def plan(cfg):
+    vision=cfg.get('vision') or {}
+    if not (vision.get('gpu') is True and vision.get('expert_lease') is True):
+        raise ValueError('full suite requires GPU vision with expert lease configured')
+    return {'suite': 'full-headless-v1', 'automatic_tests': False,
+            'stages': ['kernels', 'comparison', 'vision'],
+            'kernels': kernel_check.plan(cfg),
+            'comparison_runs': len(comparisons.arms()),
+            'vision': ['cold synthetic image', 'same image cached', '3072-token text after expert restoration'],
+            'compilation': False, 'parallel_tests': False,
+            'continue_after_failed_comparison_arm': True}
+
+
+def run(root, cfg, directory, port, request):
+    directory = Path(directory)
+    folder = directory / ('full-suite-' + datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f'))
+    folder.mkdir(mode=0o700)
+    report = {'suite': 'full-headless-v1', 'status': 'running', 'pid': os.getpid(),
+              'folder': str(folder), 'budget_s': request['budget_s'], 'stages': []}
+
+    def save():
+        text = json.dumps(report, indent=2, ensure_ascii=False) + '\n'
+        for dest in (folder / 'results.json', directory / 'full-suite-latest.json'):
+            tmp = dest.with_suffix('.tmp')
+            tmp.write_text(text)
+            tmp.replace(dest)
+
+    save()
+    deadline = time.monotonic() + request['budget_s']
+    try:
+        report['plan'] = plan(cfg)
+        from l2 import vision_check
+        reference = cfg.get('comparison_reference')
+        if not reference:
+            raise ValueError('frozen previous-engine reference is missing')
+        for exe, digest in ((cfg['exe'],request['engine_sha256']),
+                            (reference['config']['exe'],reference['engine_sha256'])):
+            if hashlib.sha256(Path(exe).read_bytes()).hexdigest()!=digest:
+                raise ValueError('selected or frozen reference engine changed')
+        comparisons.check_environment()
+        for stage, runner in (('kernels', kernel_check.run), ('comparison', comparisons.run_comparison),
+                              ('vision', vision_check.run)):
+            remaining = int(deadline - time.monotonic())
+            if remaining < 300:
+                report['error'] = 'total time budget exhausted before ' + stage
+                break
+            # Each stage must finish and reap its processes before the next starts.
+            comparisons.check_environment()
+            item = {'stage': stage, 'status': 'running'}
+            report['stages'].append(item)
+            save()
+            print(f'Strata 长程测试：开始 {stage}；总报告 {folder / "results.json"}', flush=True)
+            child = dict(request, budget_s=remaining, groups=None, continue_on_failure=True)
+            result = runner(root, cfg, folder, port, child)
+            item.update(status=result['status'], report=result)
+            save()
+            # Do not benchmark model kernels after a failed correctness prerequisite.
+            if stage == 'kernels' and result['status'] != 'passed':
+                report['error'] = 'kernel prerequisite failed; model stages were not run'
+                break
+        report['status'] = 'passed' if len(report['stages']) == 3 and all(
+            s['status'] == 'passed' for s in report['stages']) else 'incomplete'
+    except KeyboardInterrupt:
+        report.update(status='interrupted', error='interrupted; retaining completed results')
+        if report['stages'] and report['stages'][-1]['status']=='running':
+            report['stages'][-1]['status']='interrupted'
+        raise
+    except Exception as exc:
+        report.update(status='failed', error=str(exc))
+    finally:
+        save()
+        print(f'Strata 长程测试 {report["status"]}；总报告 {folder / "results.json"}', flush=True)
+    return report
