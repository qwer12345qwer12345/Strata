+"""Explicit prebuilt GPU correctness checks and a resident-weight Dense sweep."""
+import datetime
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import time
+import xml.etree.ElementTree as ET
+from l2 import headless_experiments as runner
+
+
+def plan(cfg):
+    return {'suite':'kernel-check-v1','automatic_tests':False,
+            'checks':['K8V4 decode TC named/default dispatch','Q8 HC persistent and QFUSE',
+                      'TQ INT8 and F16 prefill','resident complement batch exchange',
+                      'vision expert lease','Dense resident-weight layout latency sweep'],
+            'compilation':False,'model_requests':False}
+
+
+def run(root,cfg,directory,port,request):
+    runner.check_environment()
+    if hashlib.sha256(Path(cfg['exe']).read_bytes()).hexdigest()!=request['engine_sha256']:
+        raise ValueError('selected kernel-check engine changed')
+    folder=directory/('kernel-check-'+datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f'))
+    folder.mkdir(parents=True,mode=0o700)
+    build=root/'build'
+    commands=[['ctest','--test-dir',str(build),'--output-on-failure','--no-tests=error','--output-junit',str(folder/'ctest.xml'),'-R',
+               '^(qsa_decode_tc_parity(_env)?|hc_persist_(parity|default_off)|file_expert_source_rotation_gpu|vision_expert_lease_gpu_test)$']]
+    exe=build/'prefill_fused_iq_test'
+    report={'status':'failed','plan':plan(cfg),'steps':[]}
+    deadline=time.monotonic()+request.get('budget_s',2700)
+    def timeout(limit):
+        remaining=deadline-time.monotonic()
+        if remaining<=0:raise TimeoutError('kernel stage time budget exhausted')
+        return min(limit,remaining)
+    try:
+        for n,command in enumerate(commands):
+            with (folder/f'correctness-{n}.log').open('w') as log:
+                result=subprocess.run(command,stdout=log,stderr=subprocess.STDOUT,timeout=timeout(300))
+            report['steps'].append({'check':'synthetic-correctness','returncode':result.returncode})
+            if result.returncode:raise RuntimeError('synthetic GPU checks failed; inspect correctness log')
+            cases=ET.parse(folder/'ctest.xml').getroot().findall('.//testcase')
+            skipped=[case.get('name') for case in cases if case.find('skipped') is not None]
+            report['steps'][-1].update(tests=len(cases),skipped=skipped)
+            if len(cases)!=6 or skipped:
+                report['status']='incomplete'
+                raise RuntimeError('required GPU checks were absent or skipped')
+        import os
+        for mode in (0,1):
+            with (folder/f'tq-f16-{mode}.log').open('w') as log:
+                result=subprocess.run([str(exe),'--only=+ T','--folded','--edge','--no-timing'],
+                    env={**os.environ,'STRATA_PF_FUSED_TQ':'1','STRATA_PF_FUSED_TQ_F16':str(mode),'STRATA_PF_BATCH':'256'},
+                    stdout=log,stderr=subprocess.STDOUT,timeout=timeout(300))
+            report['steps'].append({'check':'tq-f16','mode':mode,'returncode':result.returncode})
+            if result.returncode:raise RuntimeError('TQ numerical check failed; inspect fixture and reference before enabling')
+        with (folder/'dense-layout.jsonl').open('w') as out,(folder/'dense-layout.stderr.log').open('w') as err:
+            result=subprocess.run([str(build/'dense_layout_sweep'),'128','4'],stdout=out,stderr=err,timeout=timeout(1800))
+        report['steps'].append({'check':'dense-layout','returncode':result.returncode})
+        if result.returncode:raise RuntimeError('Dense sweep failed or target hardware unavailable')
+        report['status']='passed'
+    except Exception as exc:report['error']=str(exc)
+    finally:
+        (folder/'results.json').write_text(json.dumps(report,indent=2)+'\n')
+        print(f'Strata 手动内核检查 {report["status"]}；报告 {folder/"results.json"}',flush=True)
+    return report
