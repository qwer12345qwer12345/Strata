@@ -0,0 +1,148 @@
+"""The reader's whole lifetime lies between borrow and restore, under the FIFO."""
+import contextlib
+import io
+from pathlib import Path
+import subprocess
+import tempfile
+import threading
+import unittest
+from unittest import mock
+from serve import test_vram
+from serve.frontend import ChatTemplate
+from serve.server import ByteTokenizer,ClientGone,EngineDied,Service,Vision,apply_vision_defaults
+
+class Reader:
+    expert_lease=True
+    elastic=True
+    elastic_mib=2048
+    def __init__(self,folder,events):
+        self.dir=folder;self.events=events;self.up=False;self.cache={};self.fail=False
+        self.rows=folder/'image.sve';self.rows.write_bytes(b'embeddings')
+    def alive(self):return self.up
+    def restart(self):self.events.append('reader-start');self.up=True
+    def unload(self):self.events.append('reader-reaped');self.up=False
+    def all_cached(self,images):return all(x in self.cache for x in images)
+    def encode(self,source,keep=()):
+        if source in self.cache:return self.cache[source]
+        assert self.up
+        self.events.append('encode')
+        if self.fail:raise ValueError('encoder failed')
+        self.cache[source]=(self.rows,3);return self.cache[source]
+    encode_all=Vision.encode_all
+
+class LeaseVision(unittest.TestCase):
+    def setUp(self):
+        self.temp=tempfile.TemporaryDirectory();self.addCleanup(self.temp.cleanup)
+        self.folder=Path(self.temp.name);self.events=[];self.tok=ByteTokenizer()
+        self.engine=test_vram.VramEngine(self.tok);self.engine.loaded=True
+        self.reader=Reader(self.folder,self.events)
+        self.service=Service(self.engine,self.tok,ChatTemplate(Path(__file__).with_name('chat_template.jinja')),vision=self.reader)
+        self.service.free_vram_mib=lambda:None
+        def lease(reserve,timeout=300):
+            self.events.append('restore' if reserve is None else 'borrow')
+            return {'state':'idle' if reserve is None else 'held'}
+        self.engine.vision_lease=lease
+        self.addCleanup(self.drop_embeddings)
+    def drop_embeddings(self):
+        obj=getattr(self.service,'embeddings',None)
+        if obj is not None and getattr(obj,'path',None):obj.path.unlink(missing_ok=True)
+    def picture(self,images=('a.png',),cancel=None):
+        messages=[{'role':'user','content':[{'type':'text','text':'describe'}]+[{'type':'image','source':src} for src in images]}]
+        return self.service.prepare(messages,None,{},cancel=cancel)
+    def test_multi_image_stops_and_restores_before_prepare_returns(self):
+        self.picture(('a.png','b.png'))
+        self.assertEqual(self.events,['borrow','reader-start','encode','encode','reader-reaped','restore'])
+        self.assertFalse(self.service.vision_lease_held)
+        self.assertFalse(self.reader.alive())
+        self.assertEqual(self.engine.calls,[]) # never generic VRAM resize
+    def test_cached_image_needs_no_reader_or_lease(self):
+        self.picture();self.events.clear();self.picture()
+        self.assertEqual(self.events,[])
+    def test_encoder_failure_and_cancel_both_restore(self):
+        self.reader.fail=True
+        with self.assertRaisesRegex(ValueError,'encoder failed'):self.picture()
+        self.assertEqual(self.events[-2:],['reader-reaped','restore'])
+        self.assertFalse(self.service.vision_lease_held)
+        self.reader.fail=False;cancel=threading.Event();original=self.reader.encode
+        def encode(*a,**kw):
+            result=original(*a,**kw);cancel.set();return result
+        self.reader.encode=encode
+        with self.assertRaises(ClientGone):self.picture(('b.png','c.png'),cancel)
+        self.assertEqual(self.events[-2:],['reader-reaped','restore'])
+    def test_start_failure_also_restores(self):
+        def fail():raise RuntimeError('reader start failed')
+        self.reader.restart=fail
+        with self.assertRaisesRegex(RuntimeError,'reader start failed'):self.picture()
+        self.assertEqual(self.events,['borrow','reader-reaped','restore'])
+    def test_begin_failure_still_sends_idempotent_end(self):
+        original=self.engine.vision_lease
+        def fail(reserve,timeout=300):
+            if reserve is not None:raise ValueError('borrow failed')
+            return original(reserve,timeout)
+        self.engine.vision_lease=fail
+        with self.assertRaisesRegex(EngineDied,'borrow failed'):self.picture()
+        self.assertEqual(self.events,['reader-reaped','restore'])
+    def test_failed_restore_blocks_turn_and_next_text_retries(self):
+        original=self.engine.vision_lease;failed=[False]
+        def fail(reserve,timeout=300):
+            if reserve is None and not failed[0]:failed[0]=True;raise ValueError('cannot map cache')
+            return original(reserve,timeout)
+        self.engine.vision_lease=fail
+        with self.assertRaisesRegex(EngineDied,'not been restored'):self.picture()
+        self.assertTrue(self.service.vision_lease_held)
+        self.service.prepare([{'role':'user','content':'text'}],None,{})
+        self.assertFalse(self.service.vision_lease_held)
+        self.assertEqual(self.events[-1],'restore')
+    def test_unreaped_reader_prevents_remapping(self):
+        proc=mock.Mock();proc.poll.return_value=None;proc.wait.side_effect=subprocess.TimeoutExpired('reader',10)
+        self.reader.proc=proc
+        with self.assertRaisesRegex(EngineDied,'not been restored'):self.picture()
+        self.assertNotIn('restore',self.events)
+        self.assertTrue(self.service.vision_lease_held)
+        proc.poll.return_value=0
+        self.service.prepare([{'role':'user','content':'text'}],None,{})
+        self.assertFalse(self.service.vision_lease_held)
+    def test_config_is_opt_in_and_resident_reserve_not_inflated(self):
+        cfg={'args':['--vram-reserve-mib','448'],'vision':{'gpu':True,'expert_lease':True}}
+        out=apply_vision_defaults(cfg)
+        self.assertEqual(out['env']['STRATA_VISION_EXPERT_LEASE'],'1')
+        self.assertTrue(out['vram_elastic']);self.assertTrue(out['vision']['elastic'])
+        self.assertEqual(out['args'],['--vram-reserve-mib','448'])
+        with self.assertRaises(ValueError):apply_vision_defaults({'vision':{'gpu':False,'expert_lease':True}})
+    def test_lease_reader_uses_disk_cache_parent_and_stays_unloaded(self):
+        parent=self.folder/'disk-cache'
+        v=Vision({'exe':'unused','mmproj':'unused','model':'unused','gpu':True,
+                  'expert_lease':True,'cache_parent':str(parent)})
+        try:
+            self.assertEqual(v.dir.parent,parent)
+            self.assertFalse(v.alive())
+            self.assertIsNone(v.fallback)
+        finally:v.shutdown()
+    def test_concurrent_text_prepare_waits_for_image_restore(self):
+        entered=threading.Event();release=threading.Event();text_done=threading.Event();errors=[]
+        original=self.reader.encode
+        def held_encode(*args,**kwargs):
+            entered.set()
+            if not release.wait(3):raise RuntimeError("test release timeout")
+            return original(*args,**kwargs)
+        self.reader.encode=held_encode
+        def image():
+            try:self.picture()
+            except Exception as e:errors.append(e)
+        def text():
+            try:self.service.prepare([{'role':'user','content':'text'}],None,{})
+            except Exception as e:errors.append(e)
+            finally:text_done.set()
+        a=threading.Thread(target=image);b=threading.Thread(target=text)
+        a.start();self.assertTrue(entered.wait(2));b.start()
+        try:self.assertFalse(text_done.wait(.1))
+        finally:release.set();a.join(3);b.join(3)
+        self.assertFalse(a.is_alive());self.assertFalse(b.is_alive());self.assertFalse(errors)
+        self.assertEqual(self.events[-1],'restore')
+    def test_protocol_requires_matching_end_ack(self):
+        engine=test_vram.EngineCommand().engine(['VISION_LEASE state=held released_mib=128\n','VISION_LEASE state=idle restored_experts=3\n'])
+        out=engine.vision_lease(None)
+        self.assertEqual(out['state'],'idle')
+        self.assertEqual(engine.proc.stdin.getvalue(),'VISION_LEASE END\n')
+
+if __name__=='__main__':unittest.main()
