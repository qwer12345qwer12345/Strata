+import unittest
+import io
+import json
+import contextlib
+from pathlib import Path
+import tempfile
+from unittest import mock
+from l2 import manual_compare,test_runtime_config
+from l2 import vision_check
+class VisionCheck(unittest.TestCase):
+ def test_fixture_and_plan_need_no_model(self):
+  self.assertTrue(vision_check.fixture_png().startswith(b'\x89PNG\r\n\x1a\n'))
+  cfg={'vision':{'gpu':True,'expert_lease':True}}
+  plan=vision_check.plan(cfg)
+  self.assertEqual(plan['suite'],'vision-lease-v1');self.assertFalse(plan['automatic_tests'])
+  self.assertEqual(len(plan['checks']),4)
+ def test_missing_or_cpu_vision_rejected(self):
+  for cfg in ({},{'vision':{'gpu':False,'expert_lease':True}},{'vision':{'gpu':True}}):
+   with self.assertRaises(ValueError):vision_check.plan(cfg)
+ def test_manual_vision_plan_does_not_stop_or_start_anything(self):
+  with tempfile.TemporaryDirectory() as t:
+   _,profile,_=test_runtime_config.RuntimeConfiguration().fixture(Path(t))
+   out=io.StringIO()
+   with mock.patch.object(manual_compare.subprocess,'run') as run,mock.patch.object(manual_compare.subprocess,'Popen') as popen,contextlib.redirect_stdout(out):
+    self.assertEqual(manual_compare.main(['--profile',str(profile),'--vision-check','--plan']),0)
+   run.assert_not_called();popen.assert_not_called()
