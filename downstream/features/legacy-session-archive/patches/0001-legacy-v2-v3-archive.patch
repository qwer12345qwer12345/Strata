+    if (ConversationBufferBacking::requested()) {
+        ConversationBufferBacking::deallocate(static_cast<uint8_t*>(p), bytes);
+        return;
+    }
     if (SegmentPool* pool = segment_pool())
         if (pool->deallocate(p, bytes)) return;
     ::operator delete(p);
