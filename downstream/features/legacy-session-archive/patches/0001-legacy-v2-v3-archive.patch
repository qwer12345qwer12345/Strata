diff --git a/engine/src/program/l2_cache_control.hpp b/engine/src/program/l2_cache_control.hpp
new file mode 100644
index 00000000..b074f42b
--- /dev/null
+++ b/engine/src/program/l2_cache_control.hpp
@@ -0,0 +1,102 @@
+// L2 RAM PARKED control-plane adapter.
+// This file holds all cache-control command parsing and formatting. Upstream
+// generate.cpp only gets one call site; no KV ownership moves out of the engine.
+#pragma once
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "strata/core/conversation_cache.hpp"
+
+namespace strata::core::l2control {
+
+inline std::string trim(const std::string& s) {
+    size_t a = 0, b = s.size();
+    while (a < b && (s[a] == ' ' || s[a] == '\t' || s[a] == '\r' || s[a] == '\n')) ++a;
+    while (b > a && (s[b - 1] == ' ' || s[b - 1] == '\t' || s[b - 1] == '\r' || s[b - 1] == '\n')) --b;
+    return s.substr(a, b - a);
+}
+
+inline long long number_after(const std::string& s, const char* key) {
+    const std::string k = std::string(key) + "=";
+    const size_t at = s.find(k);
+    if (at == std::string::npos) return -1;
+    return std::strtoll(s.c_str() + at + k.size(), nullptr, 10);
+}
+
+inline std::string safe_source(std::string s) {
+    for (char& c : s)
+        if (!(std::isalnum((unsigned char)c) || c == '/' || c == '.' || c == '_' || c == '-'))
+            c = '_';
+    return s;
+}
+
+inline bool cache_command(const std::string& line, ConversationCache& conversations) {
+    if (line.rfind("CACHE ", 0) != 0) return false;
+    const std::string rest = trim(line.substr(6));
+    if (rest == "STATS") {
+        const auto st = conversations.l2_stats();
+        std::printf("CACHESTAT enabled=%d budget_bytes=%zu slots=%zu entries=%zu bytes=%zu "
+                    "evictions=%zu retained_bytes=%zu pinned=%zu guarded=%zu\n",
+                    st.enabled ? 1 : 0, st.budget_bytes, st.slots, st.entries, st.bytes,
+                    st.evictions, st.retained_bytes, st.pinned, st.guarded);
+        std::fflush(stdout);
+        return true;
+    }
+    if (rest == "LIST") {
+        const auto rows = conversations.l2_list();
+        std::printf("CACHELIST %zu\n", rows.size());
+        for (const auto& e : rows) {
+            std::printf("CACHEENTRY serial=%llu tokens=%zu bytes=%zu ckpts=%zu pinned=%d guarded=%d "
+                        "cvec=%d source=%s\n",
+                        (unsigned long long)e.serial, e.tokens, e.bytes, e.checkpoints,
+                        e.pinned ? 1 : 0, e.guarded ? 1 : 0, e.cvec ? 1 : 0,
+                        safe_source(e.source).c_str());
+        }
+        std::printf("CACHEEND\n");
+        std::fflush(stdout);
+        return true;
+    }
+    long long serial = number_after(rest, "serial");
+    if (serial < 0) {
+        const size_t sp = rest.find(' ');
+        if (sp != std::string::npos) serial = std::strtoll(rest.c_str() + sp + 1, nullptr, 10);
+    }
+    const bool pin = rest.rfind("PIN ", 0) == 0;
+    const bool unpin = rest.rfind("UNPIN ", 0) == 0;
+    const bool drop = rest.rfind("DROP ", 0) == 0;
+    const bool touch = rest.rfind("TOUCH ", 0) == 0;
+    bool ok = false;
+    const char* op = "unknown";
+    if (serial >= 0) {
+        if (pin) { ok = conversations.l2_set_pinned((uint64_t)serial, true); op = "pin"; }
+        else if (unpin) { ok = conversations.l2_set_pinned((uint64_t)serial, false); op = "unpin"; }
+        else if (drop) { ok = conversations.l2_drop((uint64_t)serial); op = "drop"; }
+        else if (touch) { ok = conversations.l2_touch((uint64_t)serial); op = "touch"; }
+    }
+    if (pin || unpin || drop || touch) {
+        if (ok) std::printf("CACHEOK op=%s serial=%lld\n", op, serial);
+        else std::printf("CACHEERR op=%s serial=%lld\n", op, serial);
+    } else {
+        std::printf("CACHEERR op=unknown\n");
+    }
+    std::fflush(stdout);
+    return true;
+}
+
+inline std::string probe_extra(const ConversationCache::Match& best) {
+    return " parked_best=" + std::to_string(best.tokens) +
+           " parked_serial=" + std::to_string(best.serial) +
+           " parked_live=" + (best.live ? "1" : "0");
+}
+
+inline uint64_t mark_source(ConversationCache& conversations, const std::string& path) {
+    const uint64_t serial = conversations.l2_last_serial();
+    conversations.l2_set_source(serial, path);
+    return serial;
+}
+
+} // namespace strata::core::l2control
diff --git a/terminal/l2/bench_rotation.py b/terminal/l2/bench_rotation.py
new file mode 100644
index 00000000..98d142a3
--- /dev/null
+++ b/terminal/l2/bench_rotation.py
@@ -0,0 +1,206 @@
+#!/usr/bin/env python3
+"""End-to-end L2 rotation benchmark.
+
+Builds three synthetic conversations (two long, one short), rotates
+between them to test cache reuse, restarts the engine to test disk
+restore, and reports per-request reuse metrics.
+
+Usage:
+    python3 l2/bench_rotation.py --url http://127.0.0.1:8080 [--restart-cmd CMD]
+
+Requirements:
+    - Strata server with --slot-save-path and STRATA_SESSION_V2=1
+    - The reference controller (l2/reference_controller.py) running,
+      or use --direct to talk to the engine directly.
+"""
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+import time
+import urllib.request
+
+PARAGRAPH = (
+    "The layered cache architecture stores attention keys and values "
+    "in page-aligned cells while boundary checkpoints preserve message "
+    "edges so a diverging conversation can still borrow the deepest "
+    "common prefix; the engine streams quantized tensors through the "
+    "pinned host pool at memory bandwidth. "
+)
+
+
+def chat(url, messages, tag, timeout=600, api_key=None):
+    """Send a chat request and return (latency_s, prompt_tokens, cached_tokens, answer)."""
+    body = {
+        "messages": messages,
+        "max_tokens": 8,
+        "chat_template_kwargs": {"enable_thinking": False},
+    }
+    headers = {"Content-Type": "application/json"}
+    if api_key:
+        headers["Authorization"] = f"Bearer {api_key}"
+
+    req = urllib.request.Request(
+        url.rstrip("/") + "/v1/chat/completions",
+        data=json.dumps(body).encode(),
+        headers=headers,
+    )
+
+    t0 = time.time()
+    try:
+        with urllib.request.urlopen(req, timeout=timeout) as r:
+            result = json.loads(r.read())
+        dt = time.time() - t0
+        usage = result.get("usage", {})
+        prompt = usage.get("prompt_tokens", 0)
+        cached = (usage.get("prompt_tokens_details") or {}).get("cached_tokens", 0)
+        answer = (result.get("choices", [{}])[0]
+                  .get("message", {})
+                  .get("content", "")
+                  .strip()[:20])
+        reuse = cached / prompt if prompt > 1000 else 1.0
+        warn = " ⚠LOW-REUSE" if reuse < 0.30 and prompt > 1000 else ""
+        print(f"  [{tag}] {dt:.1f}s prompt={prompt} cached={cached} "
+              f"reuse={reuse:.0%}{warn} ans={answer!r}")
+        return dt, prompt, cached, answer
+    except Exception as e:
+        dt = time.time() - t0
+        print(f"  [{tag}] FAILED {dt:.1f}s: {e}")
+        return dt, 0, 0, None
+
+
+def wait_engine(url, timeout_s=300):
+    """Wait for the engine to become healthy."""
+    for _ in range(timeout_s // 5):
+        try:
+            urllib.request.urlopen(url.rstrip("/") + "/health", timeout=3).read()
+            return True
+        except Exception:
+            time.sleep(5)
+    return False
+
+
+def percentile(values, p):
+    if not values:
+        return 0
+    s = sorted(values)
+    idx = min(len(s) - 1, int(len(s) * p))
+    return s[idx]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--url", default="http://127.0.0.1:8080",
+                        help="Engine URL (direct) or controller URL")
+    parser.add_argument("--api-key", default=os.environ.get("STRATA_TEST_KEY", ""),
+                        help="API key if authentication is enabled")
+    parser.add_argument("--restart-cmd", default="",
+                        help="Command to restart the engine (e.g. 'systemctl restart my-engine')")
+    parser.add_argument("--turns", type=int, default=5,
+                        help="Number of build turns per long conversation")
+    parser.add_argument("--words-per-turn", type=int, default=300,
+                        help="Approximate words per user turn")
+    args = parser.parse_args()
+
+    results = []
+
+    def track(tag, dt, prompt, cached):
+        results.append({"tag": tag, "seconds": dt, "prompt": prompt,
+                        "cached": cached,
+                        "reuse": cached / prompt if prompt > 0 else 0})
+
+    # === Phase 1: Build three conversations ===
+    print("=== Phase 1: Build conversations ===")
+    histories = {}
+    for name, turns, words in [
+        ("LongA", args.turns, args.words_per_turn),
+        ("Short", 2, args.words_per_turn // 4),
+        ("LongB", args.turns, args.words_per_turn),
+    ]:
+        system = f"You are assistant {name}. " + PARAGRAPH * 5
+        msgs = [{"role": "system", "content": system}]
+        for i in range(turns):
+            user_text = PARAGRAPH * (words // 25) + f" (turn {i+1}, answer in one word)"
+            msgs.append({"role": "user", "content": user_text})
+            dt, pt, ct, ans = chat(args.url, msgs, f"{name}-b{i+1}",
+                                   api_key=args.api_key)
+            track(f"{name}-b{i+1}", dt, pt, ct)
+            if ans is None:
+                print(f"  !! {name} interrupted at turn {i+1}")
+                break
+            msgs.append({"role": "assistant", "content": ans})
+        histories[name] = msgs
+
+    # === Phase 2: Rotate between conversations ===
+    print("\n=== Phase 2: Rotation (cold → warm) ===")
+    for round_num in range(2):
+        for name in ("LongA", "Short", "LongB"):
+            msgs = histories[name]
+            msgs.append({"role": "user",
+                        "content": f"rotation {round_num+1}: answer one word"})
+            dt, pt, ct, ans = chat(args.url, msgs, f"{name}-r{round_num+1}",
+                                   api_key=args.api_key)
+            track(f"{name}-r{round_num+1}", dt, pt, ct)
+            if ans:
+                msgs.append({"role": "assistant", "content": ans})
+
+    # === Phase 3: Fork borrow (small conversation shares prefix with LongA) ===
+    print("\n=== Phase 3: Fork borrow ===")
+    fork = histories["LongA"][:3].copy()  # system + first user/assistant pair
+    fork.append({"role": "user",
+                "content": "fork question after shared head: answer one word"})
+    dt, pt, ct, _ = chat(args.url, fork, "Fork-borrow", api_key=args.api_key)
+    track("Fork-borrow", dt, pt, ct)
+
+    # === Phase 4: Restart and restore ===
+    if args.restart_cmd:
+        print(f"\n=== Phase 4: Engine restart ===")
+        print(f"  Running: {args.restart_cmd}")
+        subprocess.run(args.restart_cmd, shell=True, check=False)
+        if not wait_engine(args.url):
+            print("  !! Engine did not recover")
+            sys.exit(1)
+        print("  Engine recovered")
+
+        print("\n=== Phase 5: Post-restart restore ===")
+        for name in ("LongA", "Short", "LongB"):
+            msgs = histories[name]
+            msgs.append({"role": "user",
+                        "content": f"after restart: answer one word"})
+            dt, pt, ct, ans = chat(args.url, msgs, f"{name}-restart",
+                                   api_key=args.api_key)
+            track(f"{name}-restart", dt, pt, ct)
+            if ans:
+                msgs.append({"role": "assistant", "content": ans})
+    else:
+        print("\n  (skipping restart phase — no --restart-cmd given)")
+
+    # === Summary ===
+    print(f"\n{'='*60}")
+    print(f"=== Summary: {len(results)} requests ===")
+
+    low_reuse = [r for r in results if r["reuse"] < 0.30 and r["prompt"] > 1000]
+    all_reuse = [r["reuse"] for r in results if r["prompt"] > 1000]
+    all_latency = [r["seconds"] for r in results]
+
+    print(f"  Total requests:       {len(results)}")
+    print(f"  Low-reuse (<30%):     {len(low_reuse)}")
+    if all_reuse:
+        print(f"  Reuse median:         {percentile(all_reuse, 0.5):.0%}")
+        print(f"  Reuse P90:            {percentile(all_reuse, 0.9):.0%}")
+    print(f"  Latency P50:          {percentile(all_latency, 0.5):.1f}s")
+    print(f"  Latency P90:          {percentile(all_latency, 0.9):.1f}s")
+    print(f"  Failures:             {sum(1 for r in results if r['prompt'] == 0)}")
+
+    print(f"\n{'='*60}")
+    print("Per-request details:")
+    for r in results:
+        print(f"  {r['tag']:25s} {r['seconds']:6.1f}s  "
+              f"prompt={r['prompt']:6d}  cached={r['cached']:6d}  "
+              f"reuse={r['reuse']:.0%}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/terminal/l2/cache_control.py b/terminal/l2/cache_control.py
new file mode 100644
index 00000000..c803d09c
--- /dev/null
+++ b/terminal/l2/cache_control.py
@@ -0,0 +1,187 @@
+#!/usr/bin/env python3
+# L2 RAM PARKED control-plane module.
+# All gateway-facing cache lifecycle operations live here. The engine remains
+# the owner of KV memory; this module only forwards commands and parses
+# inventory/pin/preload responses from the line protocol.
+import json
+import queue
+import time
+
+CACHE_KEYS = {"parked_best", "parked_serial", "parked_live", "serial",
+              "tokens", "bytes", "ckpts", "pinned", "guarded", "cvec"}
+
+
+def _error(handler, code, msg):
+    handler._json(code, {"error": {"code": code, "message": msg}})
+
+
+def _engine(service):
+    eng = getattr(service, "engine", None)
+    if eng is None or getattr(eng, "proc", None) is None:
+        return None
+    return eng
+
+
+def _read_line(eng, timeout=10):
+    try:
+        line = eng.lines.get(timeout=timeout)
+    except queue.Empty:
+        return None
+    return line
+
+
+def _command(service, command, timeout=10):
+    """Send one CACHE command while holding the same FIFO as real requests."""
+    eng = _engine(service)
+    if eng is None:
+        return 503, {"error": {"message": "the engine is not running"}}
+    try:
+        with service.fifo:
+            eng.proc.stdin.write(command + "\n")
+            eng.proc.stdin.flush()
+            first = _read_line(eng, timeout)
+            if first is None:
+                return 504, {"error": {"message": "cache command timed out"}}
+            parts = first.split()
+            if not parts:
+                return 502, {"error": {"message": "empty cache response"}}
+            head = parts[0]
+            if head == "CACHESTAT":
+                out = {}
+                for item in parts[1:]:
+                    key, sep, value = item.partition("=")
+                    if sep:
+                        try: out[key] = int(value)
+                        except ValueError: out[key] = value
+                return 200, out
+            if head == "CACHELIST":
+                count = int(parts[1]) if len(parts) > 1 else 0
+                rows = []
+                for _ in range(count):
+                    line = _read_line(eng, timeout)
+                    if line is None:
+                        return 504, {"error": {"message": "cache list timed out"}}
+                    p = line.split()
+                    if not p or p[0] != "CACHEENTRY":
+                        return 502, {"error": {"message": "invalid cache entry"}}
+                    row = {}
+                    for item in p[1:]:
+                        key, sep, value = item.partition("=")
+                        if not sep: continue
+                        if key in ("tokens", "bytes", "ckpts", "pinned", "guarded", "cvec"):
+                            try: row[key] = int(value)
+                            except ValueError: row[key] = value
+                        else: row[key] = value
+                    rows.append(row)
+                end = _read_line(eng, timeout)
+                if end is None or end.split()[:1] != ["CACHEEND"]:
+                    return 502, {"error": {"message": "cache list end missing"}}
+                return 200, {"entries": rows}
+            if head in ("CACHEOK", "CACHEERR"):
+                out = {"ok": head == "CACHEOK"}
+                for item in parts[1:]:
+                    key, sep, value = item.partition("=")
+                    if sep:
+                        try: out[key] = int(value)
+                        except ValueError: out[key] = value
+                return (200 if out["ok"] else 404), out
+            return 502, {"error": {"message": f"unexpected cache answer: {first[:120]}"}}
+    except OSError as e:
+        return 503, {"error": {"message": f"cache engine error: {e}"}}
+    except (ValueError, IndexError) as e:
+        return 502, {"error": {"message": f"cache protocol error: {e}"}}
+
+
+def cache_stats(service):
+    return _command(service, "CACHE STATS")
+
+
+def cache_list(service):
+    return _command(service, "CACHE LIST")
+
+
+def cache_set_pinned(service, serial, pinned):
+    op = "PIN" if pinned else "UNPIN"
+    return _command(service, f"CACHE {op} serial={int(serial)}")
+
+
+def cache_drop(service, serial):
+    return _command(service, f"CACHE DROP serial={int(serial)}")
+
+
+def cache_touch(service, serial):
+    return _command(service, f"CACHE TOUCH serial={int(serial)}")
+
+
+def extend_fields(parts, rec, start=5):
+    """Merge key=value fields from a protocol line into a response dict."""
+    for item in parts[start:]:
+        key, sep, value = item.partition("=")
+        if not sep:
+            continue
+        try:
+            rec[key] = int(value)
+        except ValueError:
+            rec[key] = value
+    return rec
+
+
+def preload(service, body, render, rid="", timeout=180):
+    """Read an L2 file as PARKED (RESTOREPP when ids are available), never active."""
+    eng = _engine(service)
+    if eng is None:
+        return 503, {"error": {"message": "the engine is not running"}}
+    filename = body.get("filename") if isinstance(body, dict) else None
+    if not filename:
+        return 400, {"error": {"message": "filename is required"}}
+    try:
+        messages, tools, kwargs = render(body)
+        ids = service.encode_prompt(messages, tools, kwargs, store=False)
+    except Exception as e:
+        return 400, {"error": {"message": f"preload render failed: {e}"}}
+    service._restorepp_ids = ids
+    try:
+        code, result = service.slot_action("0", "restorepp", filename, rid=rid)
+    except Exception as e:
+        return 503, {"error": {"message": f"preload engine error: {e}"}}
+    if code == 200 and isinstance(result, dict) and body.get("pin", True):
+        serial = result.get("serial")
+        if serial is not None:
+            _pcode, pin_result = cache_set_pinned(service, serial, True)
+            result["pin"] = pin_result
+    return code, result
+
+
+def handle_cache_get(handler, service, path):
+    if path == "/v1/cache/stats":
+        code, body = cache_stats(service)
+        handler._json(code, body)
+        return True
+    if path == "/v1/cache/list":
+        code, body = cache_list(service)
+        handler._json(code, body)
+        return True
+    return False
+
+
+def handle_cache_post(handler, service, path, req, render, rid=""):
+    if path in ("/v1/cache/pin", "/v1/cache/unpin", "/v1/cache/drop", "/v1/cache/touch"):
+        serial = req.get("serial")
+        if isinstance(serial, bool) or not isinstance(serial, int) or serial < 0:
+            _error(handler, 400, "serial must be a non-negative integer")
+            return True
+        if path.endswith("/pin"):
+            code, body = cache_set_pinned(service, serial, True)
+        elif path.endswith("/unpin"):
+            code, body = cache_set_pinned(service, serial, False)
+        elif path.endswith("/drop"):
+            code, body = cache_drop(service, serial)
+        else:
+            code, body = cache_touch(service, serial)
+        handler._json(code, body)
+        return True
+    if path == "/v1/cache/preload":
+        code, body = preload(service, req, render, rid=rid)
+        handler._json(code, body)
+        return True
+    return False
