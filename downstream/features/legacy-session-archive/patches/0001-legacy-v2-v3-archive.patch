+    if (ConversationBufferBacking::requested()) {
+        if (void* p = ConversationBufferBacking::allocate(bytes)) return p;
+        throw std::bad_alloc();
+    }
     if (SegmentPool* pool = segment_pool())
         if (void* p = pool->allocate(bytes)) return p;
     return ::operator new(bytes);
 }
