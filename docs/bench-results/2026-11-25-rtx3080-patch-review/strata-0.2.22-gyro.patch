+import contextlib
+import hashlib
+import io
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+from l2 import full_suite as suite
+
+
+class FullSuite(unittest.TestCase):
+    def fixture(self, root):
+        exe=root/'engine';exe.write_bytes(b'engine')
+        digest=hashlib.sha256(b'engine').hexdigest()
+        cfg={'exe':str(exe),'vision':{'gpu':True,'expert_lease':True},
+             'comparison_reference':{'config':{'exe':str(exe)},'engine_sha256':digest}}
+        return cfg,dict(engine_sha256=digest,budget_s=86400)
+
+    def run_stages(self, root, statuses, interrupted=False):
+        cfg,request=self.fixture(root);seen=[]
+        def stage(name):
+            def run(*args):
+                latest=json.loads((root/'full-suite-latest.json').read_text())
+                self.assertEqual(latest['stages'][-1],{'stage':name,'status':'running'})
+                seen.append(name)
+                if interrupted and name=='comparison':raise KeyboardInterrupt
+                self.assertTrue(args[-1]['continue_on_failure'])
+                return {'status':statuses[name]}
+            return run
+        with patch.object(suite.comparisons,'check_environment'),patch.object(suite.kernel_check,'run',stage('kernels')),patch.object(suite.comparisons,'run_comparison',stage('comparison')),patch('l2.vision_check.run',stage('vision')),contextlib.redirect_stdout(io.StringIO()):
+            result=suite.run(root,cfg,root,8096,request)
+        return result,seen
+
+    def test_sequential_full_suite_continues_after_recoverable_arm_failure(self):
+        with tempfile.TemporaryDirectory() as t:
+            root=Path(t)
+            result,seen=self.run_stages(root,{'kernels':'passed','comparison':'incomplete','vision':'passed'})
+            self.assertEqual(seen,['kernels','comparison','vision'])
+            self.assertEqual(result['status'],'incomplete')
+            self.assertEqual(json.loads((root/'full-suite-latest.json').read_text())['status'],'incomplete')
+
+    def test_failed_kernel_prerequisite_never_runs_model(self):
+        with tempfile.TemporaryDirectory() as t:
+            result,seen=self.run_stages(Path(t),{'kernels':'failed'})
+            self.assertEqual(seen,['kernels']);self.assertEqual(result['status'],'incomplete')
+
+    def test_interrupt_preserves_completed_results(self):
+        with tempfile.TemporaryDirectory() as t:
+            root=Path(t)
+            with self.assertRaises(KeyboardInterrupt):
+                self.run_stages(root,{'kernels':'passed'},interrupted=True)
+            result=json.loads((root/'full-suite-latest.json').read_text())
+            self.assertEqual(result['status'],'interrupted')
+            self.assertEqual([s['status'] for s in result['stages']],['passed','interrupted'])
+
+
+if __name__=='__main__':unittest.main()
