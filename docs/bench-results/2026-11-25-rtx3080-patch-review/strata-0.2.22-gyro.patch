+    with mock.patch.object(vision_check.runner,'check_environment'),mock.patch.object(vision_check.runner,'run_phase',side_effect=phase),mock.patch.object(vision_check.time,'monotonic',return_value=100),contextlib.redirect_stdout(io.StringIO()):
