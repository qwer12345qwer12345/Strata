+"""Explicit full-resident headless vision lifecycle check; never called at startup."""
+import base64
+import copy
+import datetime
+import hashlib
+import json
+from pathlib import Path
+import re
+import struct
+import time
+import zlib
+from l2 import headless_experiments as runner
+from l2.chat_latency import workloads
+from l2.runtime_config import set_options
+
+
+def fixture_png():
+    # Deterministic test media: three red/green/blue rectangles, no user data/Pillow.
+    w,h=192,96
+    rows=[]
+    for y in range(h):
+        row=bytearray()
+        for x in range(w):
+            rgb=(255,255,255)
+            if 12<=y<80 and 4<=x%64<60:rgb=((255,0,0),(0,160,0),(0,0,255))[x//64]
+            row.extend(rgb)
+        rows.append(b'\0'+row)
+    def chunk(tag,data):return struct.pack('>I',len(data))+tag+data+struct.pack('>I',zlib.crc32(tag+data)&0xffffffff)
+    return b'\x89PNG\r\n\x1a\n'+chunk(b'IHDR',struct.pack('>IIBBBBB',w,h,8,2,0,0,0))+chunk(b'IDAT',zlib.compress(b''.join(rows)))+chunk(b'IEND',b'')
+
+
+def plan(cfg):
+    vision=cfg.get('vision') or {}
+    if not (vision.get('gpu') is True and vision.get('expert_lease') is True):
+        raise ValueError('vision check requires configured vision.gpu=true and vision.expert_lease=true')
+    return {'suite':'vision-lease-v1','automatic_tests':False,
+            'checks':['text warmup','cold synthetic image','same image cached','3072-token text after expert restoration'],
+            'requires':'full resident RAM complement and zero decode expert file reads',
+            'image_fixture_sha256':hashlib.sha256(fixture_png()).hexdigest()}
+
+
+def run(root,cfg,directory,port,request):
+    spec=plan(cfg);runner.check_environment()
+    with Path(cfg['exe']).open('rb') as f:
+        if hashlib.file_digest(f,'sha256').hexdigest()!=request['engine_sha256']:
+            raise ValueError('vision check engine changed')
+    folder=directory/('vision-lease-'+datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f'))
+    folder.mkdir(parents=True,mode=0o700)
+    seed=folder/'expert-profile.bin';args=cfg['args'];seed.write_bytes(Path(args[args.index('--expert-profile')+1]).read_bytes())
+    trial=copy.deepcopy(cfg)
+    trial['vision']['cache_parent']=str(folder/'vision-cache')
+    for flag in ('--expert-profile-save','--expert-profile'):
+        while flag in trial['args']:
+            i=trial['args'].index(flag);del trial['args'][i:i+2]
+    trial['args']=set_options(trial['args'],{'--expert-profile':seed,'--conversation-cache-mib':0,'--conversation-cache-slots':0})
+    for key in ('startup_benchmark','slot_save_path','l2_backend_port','l2_disk_budget_mib'):trial.pop(key,None)
+    trial['env'].update(STRATA_DRAFT_LOG='1',STRATA_DECODE_TIMING='1',STRATA_CONV_DISK_DIR=str(folder/'trial/parked'))
+    image=[{'type':'text','text':'Name the three colored rectangles from left to right. Answer briefly in English.'},
+           {'type':'image_url','image_url':{'url':'data:image/png;base64,'+base64.b64encode(fixture_png()).decode()}}]
+    warmup,long_output,*_=workloads()
+    cases=(warmup,('image_cold',image,64),('image_cached',image,64),('text_after_restore',long_output[1],3072))
+    result=runner.run_phase(root,trial,'vision',folder/'trial',seed,port,
+        time.monotonic()+max(300,request.get('budget_s',1200)),
+        workloads=cases,launch_profile=trial,stream_latency=True)
+    engine_log=(folder/'trial/engine.log').read_text(errors='replace')
+    if result['status']=='passed' and any(note in engine_log for note in
+            ('whole resident RAM mode does not fit','FileExpertSource: RAM budget ')):
+        result.update(status='failed',error='full expert complement residency was not confirmed')
+    transcript=(folder/'trial/server.log').read_text(errors='replace')
+    begins=re.findall(r'VISION_LEASE state=held ([^\n]*)',transcript)
+    ends=re.findall(r'VISION_LEASE state=idle ([^\n]*)',transcript)
+    result.update(spec=spec,lease_begins=len(begins),lease_ends=len(ends),borrow_records=begins,restore_records=ends)
+    if result['status']=='passed' and (len(begins)!=1 or len(ends)!=1):
+        result.update(status='failed',error='cold picture must borrow/restore once; cached picture must not borrow again')
+    if result['status']=='passed' and any(r['timings']['predicted_n']<1 for r in result['cases']):
+        result.update(status='failed',error='empty model output')
+    if result['status']=='passed' and result['cases'][-1]['timings']['predicted_n'] < 3072*.75:
+        result.update(status='invalid',error='post-restoration text ended before 75% of the requested length')
+    (folder/'results.json').write_text(json.dumps(result,indent=2)+'\n')
+    print(f'Strata 手动识图检查 {result["status"]}；报告 {folder/"results.json"}',flush=True)
+    return result
