--- /dev/null
+++ b/terminal/l2/test_startup_ablation.py
@@ -0,0 +1,48 @@
+import json
+import tempfile
+import time
+import unittest
+from pathlib import Path
+from unittest.mock import Mock, patch
+
+from l2 import startup_ablation
+
+
+class StartupAblation(unittest.TestCase):
+    def test_low_ram_and_new_swap_do_not_stop_a_trial(self):
+        with tempfile.TemporaryDirectory() as t:
+            folder = Path(t)
+            engine_log = folder / 'engine.log'
+            proc = Mock(pid=1234)
+            (folder / 'ready.json').write_text(json.dumps({
+                'pid': proc.pid, 'api_state': 'ready', 'model_state': 'ready',
+                'bound_host': '127.0.0.1', 'bound_port': 8123,
+            }))
+            engine_log.write_text('resident RAM mode: page-locked\nDFlash2 drafter on\n')
+            result = {}
+            mem_before = dict(MemAvailable=1536, SwapTotal=2048, SwapFree=2048)
+            mem_during = dict(MemAvailable=256, SwapTotal=2048, SwapFree=1024)
+
+            def fake_case(*args, **kwargs):
+                deadline = time.monotonic() + 3
+                while result['memory']['max_new_swap_mib'] == 0 and time.monotonic() < deadline:
+                    time.sleep(0.02)
+                with engine_log.open('a') as f:
+                    f.write('0 blob reads from the file\nsuffix drafts: 0 windows, 0 of 0 drafts accepted\n')
+                return {'timings': {'predicted_n': 64}}
+
+            with patch.object(startup_ablation.subprocess, 'Popen', return_value=proc), \
+                    patch.object(startup_ablation, 'stop_trial'), \
+                    patch.object(startup_ablation, 'run_case', side_effect=fake_case), \
+                    patch.object(startup_ablation, 'meminfo', side_effect=lambda: (
+                        mem_during if 'memory' in result else mem_before)):
+                startup_ablation.serve_trial(folder, {'env': {}, 'log': str(engine_log)}, folder,
+                                             time.monotonic() + 5, result,
+                                             workloads=(('decode', 'prompt', 64),))
+            self.assertEqual(result['status'], 'measured')
+            self.assertEqual(result['memory'], {'min_available_mib': 256, 'max_new_swap_mib': 1024})
+            proc.send_signal.assert_not_called()
+
+
+if __name__ == '__main__':
+    unittest.main()
