+bool Dflash2Drafter::record_decode_context(const float* taps, int n, cudaStream_t cs, std::string& err, bool narrow_rope) {
+    if (n <= kRows) return record_context(taps, n, cs, err, narrow_rope);
+
+    // Match the bridge's arithmetic and keep its scratch size. The final row
+    // releases each attention layer only after all earlier rows are in its ring.
+    const size_t stride = taps_.size() * (size_t) N_;
